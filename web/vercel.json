{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/style.css", "dest": "/css/styles.css" },
    { "src": "/css/style.css", "dest": "/css/styles.css" },
    { "src": "/css/auth.css", "dest": "/css/styles.css" },
    { "src": "/styles.css", "dest": "/css/styles.css" },
    { "src": "/api/(.*)", "dest": "/api/index.js?path=/api/$1" },
    { "src": "/admin", "dest": "/admin-dashboard.html" },
    { "src": "/admin/login", "dest": "/admin-login.html" },
    { "src": "/admin/dashboard", "dest": "/admin-dashboard.html" },
    { "src": "/admin/courses", "dest": "/admin-courses.html" },
    { "src": "/admin/categories", "dest": "/admin-categories.html" },
    { "src": "/admin/students", "dest": "/admin-students.html" },
    { "src": "/admin/transactions", "dest": "/admin-transactions.html" },
    { "src": "/admin/settings", "dest": "/admin-settings.html" },
    { "src": "/courses", "dest": "/courses.html" },
    { "src": "/student-login", "dest": "/student-login.html" },
    { "src": "/login", "dest": "/student-login.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
